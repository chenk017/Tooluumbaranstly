<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="UmbaranAssetBrowserUI.Views.InspectorView">

    <Border Padding="10">

        <StackPanel>

            <TextBlock Text="Inspector"
                       FontSize="20"/>

            <TextBlock Text="PathID : 0"
                       Margin="0,15,0,0"/>

            <TextBlock Text="Type : GameObject"/>

            <TextBlock Text="Fields"
                       Margin="0,15,0,0"/>

        </StackPanel>

    </Border>

</UserControl>
