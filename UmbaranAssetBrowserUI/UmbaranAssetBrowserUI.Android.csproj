<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>

    <OutputType>Exe</OutputType>

    <TargetFramework>net8.0-android34.0</TargetFramework>
    <TargetPlatformVersion>34.0</TargetPlatformVersion>

    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>

    <!-- Android App Info -->
    <ApplicationTitle>Umbaran Asset Browser</ApplicationTitle>
    <ApplicationId>com.umbaran.assetbrowser</ApplicationId>

    <ApplicationVersion>1</ApplicationVersion>
    <ApplicationDisplayVersion>0.1</ApplicationDisplayVersion>


    <!-- Android Minimum -->
    <SupportedOSPlatformVersion>23</SupportedOSPlatformVersion>

    <AndroidUseLatestPlatformSdk>true</AndroidUseLatestPlatformSdk>

    <!-- Runtime -->
    <RuntimeIdentifiers>android-arm64</RuntimeIdentifiers>


    <!-- APK -->
    <AndroidPackageFormat>apk</AndroidPackageFormat>

    <AndroidCreatePackagePerAbi>false</AndroidCreatePackagePerAbi>


    <!-- Build Stability -->
    <PublishTrimmed>false</PublishTrimmed>
    <RunAOTCompilation>false</RunAOTCompilation>
    <AndroidEnableProfiledAot>false</AndroidEnableProfiledAot>


    <!-- Avalonia Android -->
    <AndroidEnableMultiDex>true</AndroidEnableMultiDex>

  </PropertyGroup>


  <ItemGroup>

    <PackageReference Include="Avalonia"
                      Version="11.2.3" />

    <PackageReference Include="Avalonia.Android"
                      Version="11.2.3" />

    <PackageReference Include="Avalonia.Themes.Fluent"
                      Version="11.2.3" />

    <PackageReference Include="Avalonia.Fonts.Inter"
                      Version="11.2.3" />

  </ItemGroup>


</Project>
