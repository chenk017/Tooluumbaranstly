<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:UmbaranAssetBrowserUI.Views"
        x:Class="UmbaranAssetBrowserUI.MainWindow"
        Width="1000"
        Height="650"
        Title="Umbaran Asset Browser">

    <Grid RowDefinitions="50,*">

        <!-- Header -->
        <Border Grid.Row="0"
                Padding="10">

            <TextBlock Text="Umbaran Asset Browser"
                       FontSize="24"/>

        </Border>


        <!-- Main Area -->
        <Grid Grid.Row="1"
              ColumnDefinitions="300,*">


            <!-- Asset List -->
            <Border Grid.Column="0"
                    BorderThickness="1"
                    Padding="5">

                <views:AssetListView />

            </Border>


            <!-- Inspector -->
            <Border Grid.Column="1"
                    BorderThickness="1"
                    Padding="5">

                <views:InspectorView />

            </Border>


        </Grid>

    </Grid>

</Window>
